# Free Claude Code - Pre-configured for OpenCode Free Tier
# The proxy works out of the box with OpenCode's free models.
# Change these in the Admin UI (http://localhost:8082/admin) after installation.

# OpenCode free-tier access (no signup needed with "public" key)
OPENCODE_API_KEY="public"

# Route all Claude model requests to OpenCode free models
# Available free models: deepseek-v4-flash-free, mimo-v2.5-free, nemotron-3-ultra-free,
#                        qwen3.6-plus-free, minimax-m3-free, north-mini-code-free
MODEL="opencode/deepseek-v4-flash-free"
MODEL_OPUS="opencode/deepseek-v4-flash-free"
MODEL_SONNET="opencode/deepseek-v4-flash-free"
MODEL_HAIKU="opencode/deepseek-v4-flash-free"

# Local server settings
ANTHROPIC_AUTH_TOKEN="freecc"
FCC_OPEN_BROWSER=false
PORT=8082
LOG_API_ERROR_TRACEBACKS=false
LOG_RAW_SSE_EVENTS=false

# Rate limiting
PROVIDER_RATE_LIMIT=10
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=3

# Enable thinking blocks
ENABLE_MODEL_THINKING=true

# HTTP timeouts
HTTP_READ_TIMEOUT=120
HTTP_WRITE_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=15

# Disable messaging platforms (Discord/Telegram)
MESSAGING_PLATFORM="none"
